# ---------------------------------------------------------------------------
# gloveda.co (the parent site): environment. Copy to .env.local to override. Never commit real values.
# Every value has a production default; none is required.
# ---------------------------------------------------------------------------

# Canonical origin of this site (no trailing slash). Default: https://gloveda.co
# NEXT_PUBLIC_SITE_URL=https://gloveda.co
# The Gloveda Herbals shop (its own project, site/ in this repository). Default: https://herbals.gloveda.co
# For local work, point it at the shop's local server, e.g. http://localhost:3000
# NEXT_PUBLIC_SHOP_ORIGIN=https://herbals.gloveda.co

# Google Tag Manager container id, e.g. GTM-XXXXXXX. Loaded only after the visitor accepts cookies.
NEXT_PUBLIC_GTM_ID=
