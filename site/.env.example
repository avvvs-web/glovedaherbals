# ---------------------------------------------------------------------------
# Gloveda Herbals: environment. Copy to .env.local and fill in. Never commit real values.
# Run `npm run check:shopify` to see which connections are live.
# The step-by-step for each value is in docs/shopify-setup.md.
# ---------------------------------------------------------------------------

# --- This site ---
# Canonical origin of the story site (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://glovedaherbals.com
# Where the shop lives (every shopping link points here)
NEXT_PUBLIC_SHOP_ORIGIN=https://shop.glovedaherbals.com
# Local development: serve the shop from this app's /shop routes instead
# NEXT_PUBLIC_SHOP_ORIGIN=http://localhost:3000/shop
# Hostnames that are served from the /shop routes in production (comma separated)
SHOP_HOSTS=shop.glovedaherbals.com

# --- 1. Public catalogue (works today, no token) ---
# The Shopify store whose public catalogue the shop reads until a Storefront token is supplied
SHOPIFY_PUBLIC_STORE_URL=https://glovedaherbals.com
SHOPIFY_CURRENCY=INR

# --- 2. Storefront API (Shopify admin > Sales channels > Headless > your storefront) ---
# The store's permanent domain, e.g. xxxx.myshopify.com
SHOPIFY_STORE_DOMAIN=
# The PUBLIC Storefront API access token. Never an Admin API token.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# A currently supported version from Shopify's API release calendar, e.g. YYYY-MM
SHOPIFY_STOREFRONT_API_VERSION=

# --- 3. Customer accounts (same Headless storefront > Customer Account API) ---
# Client ID of the Customer Account API client. Sign-in stays off until this is set.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
# Only for a confidential client. Server-side only; never expose it to the browser.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=

# --- 4. Reviews (Loox) ---
# Both values are public (they are in the live store's pages). Defaults are the live store's.
NEXT_PUBLIC_LOOX_ID=psOUq3PXH6
NEXT_PUBLIC_SHOPIFY_DOMAIN=gmfcwr-v0.myshopify.com
